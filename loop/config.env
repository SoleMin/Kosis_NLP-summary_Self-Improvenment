# Loop configuration. Sourced by scripts/*.sh. The agent must not edit this file.

# Which harness runs one iteration: claude | codex
HARNESS=claude

# Stop conditions
MAX_ITER=20            # hard cap on iterations
MAX_TURNS=40           # per-iteration turn cap (claude only)
PATIENCE=3             # stop after this many iterations in a row without a better score
MAX_VERIFY_FAILS=3     # stop after this many verify failures in a row

# Commands (run from the repo root). Leave EVAL_CMD empty to keep/revert on verify alone.
VERIFY_CMD=""          # e.g. "python -m pytest -q"
EVAL_CMD=""            # e.g. "python evals/run_eval.py --golden evals/golden.jsonl"  (last stdout line = score, higher is better)

# Revert the iteration's changes when verify fails or the score drops
ROLLBACK=1
