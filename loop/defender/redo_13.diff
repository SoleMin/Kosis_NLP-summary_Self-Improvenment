@@ -0,0 +1,110 @@
+"""Loop 13 B-1 over two tables (analyze/multi_rules.py _Side.ranged, _fixed_sets, _repeated, _combined).
+
+A range of numbers the question says over the numbered names of each table ("20대", "30세 미만") is one target per
+table: each table's cells are added up first, then the calculation is made between the sums (a share, a ratio, a
+difference). The same range said twice in one question ("20대 취업자는 20대 인구의") is one range.
+
+Neighbours: one interval named in both tables (the cells themselves), and the targets of a region named one by one
+(the calculation repeated per region, as before).
+
+The tables are made up (가상 데이터); every test checks the values and the cells they come from.
+"""
+
+from __future__ import annotations
+
+import re
+
+import pytest
+
+from conftest import write_table
+from kosis_chat.adapters.parquet import load_table
+from kosis_chat.calc import calculate
+from kosis_chat.schemas.resources import load_resources
+
+YEARS = ["2021", "2022", "2023"]
+AGES = (("000", "계"), ("005", "15-19세"), ("010", "20-24세"), ("015", "25-29세"), ("020", "30-34세"),
+        ("025", "35-39세"), ("030", "40세이상"))
+
+
+def _rows(item, name, unit, scale):
+    out = []
+    for y, year in enumerate(YEARS):
+        d = {c: (31 * (k + 4) + 9 * y * (k % 2 + 1)) * scale for k, (c, _) in enumerate(AGES[1:])}
+        d["000"] = sum(d.values())
+        out += [{"period": year, "item_id": item, "item_name": name, "unit": unit, "dim1_name": "연령별",
+                 "dim1_code": c, "dim1_label": l, "value_raw": str(d[c]), "value": d[c]} for c, l in AGES]
+    return out
+
+
+def catalog(title):
+    return {"survey_name": "가상 조사", "organization": "가상 기관", "table_name": title, "period": "년",
+            "url": "https://example.invalid/t"}
+
+
+SPECS = {
+    "FAKE13_EMP": (lambda: _rows("E1", "취업자", "명", 1), catalog("가상 연령별 취업자")),
+    "FAKE13_POP": (lambda: _rows("P1", "인구", "명", 2), catalog("가상 연령별 인구")),
+}
+ROWS = {t: make() for t, (make, _) in SPECS.items()}
+
+
+@pytest.fixture(scope="module")
+def res(tmp_path_factory):
+    folder = tmp_path_factory.mktemp("loop13mr") / "data"
+    return {t: load_resources(load_table(write_table(folder, t, ROWS[t], cat))) for t, (_, cat) in SPECS.items()}
+
+
+def run(res, question):
+    got = calculate(question, [res["FAKE13_EMP"], res["FAKE13_POP"]])
+    assert got.status == "ok", (got.status, got.reason, got.detail)
+    facts = {f.id: f for f in got.facts}
+    return facts, [facts[i] for i in got.answer]
+
+
+def refs_in(facts, fact):
+    out = []
+    for i in re.findall(r"f\d+", fact.derivation or ""):
+        f = facts[i]
+        out += refs_in(facts, f) if f.derivation else [f.source_ref]
+    return sorted(out)
+
+
+def total(tbl, codes, year):
+    return sum(r["value"] for r in ROWS[tbl] if r["dim1_code"] in codes and r["period"] == year)
+
+
+def refs(tbl, codes, year):
+    item = ROWS[tbl][0]["item_id"]
+    return [f"{tbl}|{item}|{c}|{year}" for c in codes]
+
+
+def last_computed(answer):
+    return [f for f in answer if not f.source_ref][-1]
+
+
+@pytest.mark.parametrize("question, codes, year", [
+    ("2023년 20대 취업자는 20대 인구의 몇 퍼센트야?", ("010", "015"), "2023"),
+    ("2021년 30세 미만 인구 중 30세 미만 취업자가 차지하는 비중은?", ("005", "010", "015"), "2021"),
+])
+def test_share_between_the_sums_of_a_range(res, question, codes, year):
+    facts, answer = run(res, question)
+    calc = last_computed(answer)
+    expect = total("FAKE13_EMP", codes, year) / total("FAKE13_POP", codes, year) * 100
+    assert calc.value == pytest.approx(round(expect, 2), abs=0.01)
+    assert refs_in(facts, calc) == sorted(refs("FAKE13_EMP", codes, year) + refs("FAKE13_POP", codes, year))
+
+
+def test_difference_between_the_sums_of_a_range(res):
+    facts, answer = run(res, "2022년 20세부터 34세까지 인구와 취업자의 차이는?")
+    calc = last_computed(answer)
+    codes = ("010", "015", "020")
+    assert abs(calc.value) == pytest.approx(total("FAKE13_POP", codes, "2022") - total("FAKE13_EMP", codes, "2022"))
+    assert refs_in(facts, calc) == sorted(refs("FAKE13_EMP", codes, "2022") + refs("FAKE13_POP", codes, "2022"))
+
+
+def test_neighbour_one_interval_in_both_tables(res):
+    facts, answer = run(res, "2023년 25-29세 취업자는 25-29세 인구의 몇 퍼센트야?")
+    calc = last_computed(answer)
+    expect = total("FAKE13_EMP", ("015",), "2023") / total("FAKE13_POP", ("015",), "2023") * 100
+    assert calc.value == pytest.approx(round(expect, 2), abs=0.01)
+    assert refs_in(facts, calc) == sorted(refs("FAKE13_EMP", ("015",), "2023") + refs("FAKE13_POP", ("015",), "2023"))
