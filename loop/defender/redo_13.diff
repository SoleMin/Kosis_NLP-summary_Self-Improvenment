index 0000000..88d80e2
--- /dev/null
+++ b/tests/loop/test_loop13_number_ranges.py
@@ -0,0 +1,161 @@
+"""Loop 13 B-1 (shared/labels.py label_bounds, asked_ranges; analyze/rules.py _number_range, _cover, _operation).
+
+A range of numbers the question says over several numbered names of one category: a ten-year group ("20대") over
+five-year intervals, one bound with an open end ("50명 이상", "30세 미만") over intervals, single numbers and an open
+last name, two bounds wider than one name ("20세부터 34세까지"). The names the range covers end to end are one
+target: their sum for a value (no word that adds them is needed), the part for a share. The counting word is read from
+the category's names, some of which carry a number only.
+
+Neighbours: one interval or half of a ten-year group named (its cell alone), two intervals named one by one and added,
+an open name with the asked bound (its cell alone), a range whose bounds fall inside a name (no plan, as before), the
+lower bound of the group the table counts said in its title (not a range), a range of years (a period).
+
+The tables are made up (가상 데이터); every test checks the values and the cells they come from.
+"""
+
+from __future__ import annotations
+
+import re
+
+import pytest
+
+from conftest import write_table
+from kosis_chat.adapters.parquet import load_table
+from kosis_chat.calc import calculate
+from kosis_chat.schemas.resources import load_resources
+
+YEARS = ["2021", "2022", "2023"]
+# 연령: a total, five-year intervals (the first ones with no counting word) and an open last name
+AGES = (("000", "계"), ("005", "15-19"), ("010", "20-24"), ("015", "25-29세"), ("020", "30-34세"), ("025", "35-39세"),
+        ("030", "40-49세"), ("035", "50세 이상"))
+# 종사자 규모: single numbers, intervals and an open end, counted in 명
+SIZES = (("S0", "전체"), ("S1", "1명"), ("S2", "2-4명"), ("S3", "5-9명"), ("S4", "10-49명"), ("S5", "50-99명"),
+         ("S6", "100명이상"))
+
+
+def _rows(tbl, item, name, unit, dim, labels, year_scale):
+    out = []
+    for y, year in enumerate(YEARS):
+        d = {c: (37 * (k + 3) + 11 * y * (k % 3 + 1)) * year_scale for k, (c, _) in enumerate(labels[1:])}
+        d[labels[0][0]] = sum(d.values())
+        out += [{"period": year, "item_id": item, "item_name": name, "unit": unit, "dim1_name": dim, "dim1_code": c,
+                 "dim1_label": l, "value_raw": str(d[c]), "value": d[c]} for c, l in labels]
+    return out
+
+
+def catalog(title):
+    return {"survey_name": "가상 조사", "organization": "가상 기관", "table_name": title, "period": "년",
+            "url": "https://example.invalid/t"}
+
+
+SPECS = {
+    "FAKE13_AGE": (lambda: _rows("FAKE13_AGE", "E1", "취업자", "천명", "연령별", AGES, 1),
+                   catalog("가상 연령별 15세 이상 취업자")),
+    "FAKE13_SZ": (lambda: _rows("FAKE13_SZ", "B1", "사업체수", "개", "종사자규모별", SIZES, 3),
+                  catalog("가상 종사자규모별 사업체수")),
+}
+ROWS = {t: make() for t, (make, _) in SPECS.items()}
+
+
+@pytest.fixture(scope="module")
+def res(tmp_path_factory):
+    folder = tmp_path_factory.mktemp("loop13r") / "data"
+    return {t: load_resources(load_table(write_table(folder, t, ROWS[t], cat))) for t, (_, cat) in SPECS.items()}
+
+
+def ask(res, question, tbl):
+    got = calculate(question, [res[tbl]])
+    assert got.status == "ok", (got.status, got.reason, got.detail)
+    facts = {f.id: f for f in got.facts}
+    return facts, [facts[i] for i in got.answer]
+
+
+def refs_in(facts, fact):
+    out = []
+    for i in re.findall(r"f\d+", fact.derivation or ""):
+        f = facts[i]
+        out += refs_in(facts, f) if f.derivation else [f.source_ref]
+    return sorted(out)
+
+
+def value(tbl, code, year):
+    return next(r["value"] for r in ROWS[tbl] if r["dim1_code"] == code and r["period"] == year)
+
+
+def ref(tbl, code, year):
+    return f"{tbl}|{ROWS[tbl][0]['item_id']}|{code}|{year}"
+
+
+def computed(answer):
+    return [f for f in answer if not f.source_ref]
+
+
+# ---------------------------------------------------------------- the sum of the names a range covers
+
+
+@pytest.mark.parametrize("question, tbl, codes, year", [
+    ("2023년 20대 취업자는 몇 명이야?", "FAKE13_AGE", ("010", "015"), "2023"),
+    ("2022년 30세 미만 취업자 수 알려줘", "FAKE13_AGE", ("005", "010", "015"), "2022"),
+    ("2021년 20세부터 34세까지 취업자는?", "FAKE13_AGE", ("010", "015", "020"), "2021"),
+    ("2023년 종사자 50명 이상 사업체는 몇 개야?", "FAKE13_SZ", ("S5", "S6"), "2023"),
+    ("2022년 종사자가 10명 미만인 사업체 수는?", "FAKE13_SZ", ("S1", "S2", "S3"), "2022"),
+])
+def test_value_of_a_range_is_the_sum_of_its_names(res, question, tbl, codes, year):
+    facts, answer = ask(res, question, tbl)
+    calc = computed(answer)
+    assert len(calc) == 1
+    assert calc[0].value == pytest.approx(sum(value(tbl, c, year) for c in codes), abs=0.01)
+    assert refs_in(facts, calc[0]) == sorted(ref(tbl, c, year) for c in codes)
+
+
+@pytest.mark.parametrize("question, tbl, codes, whole, year", [
+    ("2023년 전체 취업자 중 20대가 차지하는 비중은?", "FAKE13_AGE", ("010", "015"), "000", "2023"),
+    ("2021년 종사자 50명 이상 사업체가 전체 사업체에서 차지하는 비중은?", "FAKE13_SZ", ("S5", "S6"), "S0", "2021"),
+])
+def test_share_of_a_range(res, question, tbl, codes, whole, year):
+    facts, answer = ask(res, question, tbl)
+    calc = computed(answer)
+    expect = sum(value(tbl, c, year) for c in codes) / value(tbl, whole, year) * 100
+    shares = [f for f in calc if "*" in (f.derivation or "")]
+    assert shares and shares[-1].value == pytest.approx(round(expect, 2), abs=0.01)
+    assert refs_in(facts, shares[-1]) == sorted(ref(tbl, c, year) for c in (*codes, whole))
+
+
+# ---------------------------------------------------------------- neighbours
+
+
+@pytest.mark.parametrize("question, tbl, code, year", [
+    ("2023년 25-29세 취업자는?", "FAKE13_AGE", "015", "2023"),
+    ("2022년 20대 후반 취업자는?", "FAKE13_AGE", "015", "2022"),
+    ("2023년 50세 이상 취업자는?", "FAKE13_AGE", "035", "2023"),
+    ("2021년 종사자 100명 이상 사업체 수는?", "FAKE13_SZ", "S6", "2021"),
+])
+def test_neighbour_one_name_is_its_cell(res, question, tbl, code, year):
+    _, answer = ask(res, question, tbl)
+    assert [f.source_ref for f in answer] == [ref(tbl, code, year)]
+
+
+def test_neighbour_two_intervals_named_one_by_one_and_added(res):
+    facts, answer = ask(res, "2023년 30-34세와 35-39세 취업자를 합하면?", "FAKE13_AGE")
+    calc = computed(answer)
+    assert calc[0].value == pytest.approx(value("FAKE13_AGE", "020", "2023") + value("FAKE13_AGE", "025", "2023"))
+    assert refs_in(facts, calc[0]) == sorted([ref("FAKE13_AGE", "020", "2023"), ref("FAKE13_AGE", "025", "2023")])
+
+
+def test_neighbour_range_inside_a_name_is_not_picked(res):
+    got = calculate("2023년 30세부터 45세까지 취업자는?", [res["FAKE13_AGE"]])
+    assert got.status != "ok" or all(f.source_ref != ref("FAKE13_AGE", "000", "2023") for f in got.facts) is False \
+        or not any(f.source_ref in {ref("FAKE13_AGE", c, "2023") for c in ("020", "025")} for f in got.facts)
+
+
+def test_neighbour_title_bound_is_the_whole(res):
+    """'15세 이상' is the group the table counts (its title): the total, not the open name above it."""
+    _, answer = ask(res, "2023년 15세 이상 취업자는?", "FAKE13_AGE")
+    assert [f.source_ref for f in answer] == [ref("FAKE13_AGE", "000", "2023")]
+
+
+def test_neighbour_year_range_is_a_period(res):
+    facts, answer = ask(res, "2021~2023년 20-24세 취업자 평균은?", "FAKE13_AGE")
+    calc = computed(answer)
+    assert calc[0].value == pytest.approx(sum(value("FAKE13_AGE", "010", y) for y in YEARS) / 3, abs=0.01)
+    assert refs_in(facts, calc[0]) == sorted(ref("FAKE13_AGE", "010", y) for y in YEARS)
