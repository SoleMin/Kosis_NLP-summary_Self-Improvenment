+def _cover(spans: dict[str, tuple[float, float]], low: float, high: float) -> list[str] | None:
+    """Loop 13: the names whose intervals put end to end make exactly [low, high] (an open low starts at the smallest
+    name, an open high ends at the largest one or an open name), each step the widest name that fits; None when the
+    range's bounds fall inside a name."""
+    if low == -INF:
+        low = min(lo for lo, _ in spans.values())
+    if high == INF:
+        tops = [hi for _, hi in spans.values()]
+        high = INF if INF in tops else max(tops)
+    picked, at = [], low
+    while at <= high:
+        fits = [(hi, c) for c, (lo, hi) in spans.items() if lo == at and hi <= high]
+        if not fits:
+            return None
+        hi, code = max(fits)
+        picked.append(code)
+        if hi == INF:
+            break
+        at = hi + 1
+    return picked
+
