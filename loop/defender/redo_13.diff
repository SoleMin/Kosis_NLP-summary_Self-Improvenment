+++ b/tests/loop/test_loop13_province_table.py
@@ -0,0 +1,174 @@
+"""Loop 13 A-1 (prepare/index.py _link_province): a table of one province and its districts.
+
+The regional category's first name is one province ('경기도', '부산광역시'; the title starts with it), the others are
+its districts. There is no total name and the codes are all of one length ('31000', '31010', '31020'), so they do not
+nest by prefix. The index links the districts under the province: a district named after its province is the only
+target, and the province is the whole when no region is named.
+
+Neighbours: a category of provinces after a total stays as it was (the provinces are the candidates of a ranking), and
+a category of numbered codes padded with zeros ('100', '110', '120') is not linked.
+
+The tables are made up (가상 데이터); every test checks the values and the cells they come from.
+"""
+
+from __future__ import annotations
+
+import re
+
+import pytest
+
+from conftest import write_table
+from kosis_chat.adapters.parquet import load_table
+from kosis_chat.calc import calculate
+from kosis_chat.schemas.resources import load_resources
+
+YEARS = ["2020", "2021", "2022", "2023"]
+GG = (("31000", "경기도"), ("31010", "수원시"), ("31020", "성남시"), ("31030", "고양시"), ("31040", "용인시"))
+BS = (("26000", "부산광역시"), ("26010", "중구"), ("26020", "서구"), ("26030", "해운대구"))
+NATION = (("00", "전국"), ("11", "서울특별시"), ("21", "부산광역시"), ("22", "대구광역시"))
+
+
+def _rows(item, name, unit, dim, regions, base):
+    out = []
+    for y, year in enumerate(YEARS):
+        d = {c: base[k] + (k + 2) * y * 7 for k, (c, _) in enumerate(regions[1:])}
+        d[regions[0][0]] = sum(d.values())
+        out += [{"period": year, "item_id": item, "item_name": name, "unit": unit, "dim1_name": dim, "dim1_code": c,
+                 "dim1_label": l, "value_raw": str(d[c]), "value": d[c]} for c, l in regions]
+    return out
+
+
+def catalog(title):
+    return {"survey_name": "가상 조사", "organization": "가상 기관", "table_name": title, "period": "년",
+            "url": "https://example.invalid/t"}
+
+
+SPECS = {
+    "FAKE13_GG": (lambda: _rows("T1", "인구", "명", "시군구별", GG, [1200, 900, 1050, 1100]),
+                  catalog("경기도 시군구별 인구")),
+    "FAKE13_BS": (lambda: _rows("B1", "사업체수", "개", "행정구역별", BS, [300, 410, 820]),
+                  catalog("부산광역시 구군별 사업체수")),
+    "FAKE13_NA": (lambda: _rows("P1", "인구", "천명", "시도별", NATION, [9400, 3300, 2400]),
+                  catalog("가상 시도별 인구")),
+}
+ROWS = {t: make() for t, (make, _) in SPECS.items()}
+
+
+@pytest.fixture(scope="module")
+def res(tmp_path_factory):
+    folder = tmp_path_factory.mktemp("loop13p") / "data"
+    return {t: load_resources(load_table(write_table(folder, t, ROWS[t], cat))) for t, (_, cat) in SPECS.items()}
+
+
+def ask(res, question, tbl):
+    got = calculate(question, [res[tbl]])
+    assert got.status == "ok", (got.status, got.reason, got.detail)
+    facts = {f.id: f for f in got.facts}
+    return facts, [facts[i] for i in got.answer]
+
+
+def refs_in(facts, fact):
+    out = []
+    for i in re.findall(r"f\d+", fact.derivation or ""):
+        f = facts[i]
+        out += refs_in(facts, f) if f.derivation else [f.source_ref]
+    return sorted(out)
+
+
+def value(tbl, code, year):
+    return next(r["value"] for r in ROWS[tbl] if r["dim1_code"] == code and r["period"] == year)
+
+
+def ref(tbl, code, year):
+    return f"{tbl}|{ROWS[tbl][0]['item_id']}|{code}|{year}"
+
+
+def cells(answer):
+    return sorted(f.source_ref for f in answer if f.source_ref)
+
+
+def computed(answer):
+    return [f for f in answer if not f.source_ref]
+
+
+# ---------------------------------------------------------------- the index
+
+
+@pytest.mark.parametrize("tbl, first", [("FAKE13_GG", "31000"), ("FAKE13_BS", "26000")])
+def test_districts_are_linked_under_the_province(res, tbl, first):
+    from kosis_chat.prepare.index import index_of
+
+    axis = next(a for n, a in index_of(res[tbl].table).axes.items() if a.regional)
+    assert axis.parents[first] is None
+    assert all(axis.parents[c] == first for c in axis.labels if c != first)
+
+
+# ---------------------------------------------------------------- a district named after its province
+
+
+@pytest.mark.parametrize("question, tbl, code, year", [
+    ("2023년 경기도 수원시 인구는?", "FAKE13_GG", "31010", "2023"),
+    ("2021년 부산 해운대구 사업체 수 알려줘", "FAKE13_BS", "26030", "2021"),
+])
+def test_value_of_a_district_after_its_province(res, question, tbl, code, year):
+    _, answer = ask(res, question, tbl)
+    assert cells(answer) == [ref(tbl, code, year)]
+    assert answer[0].value == value(tbl, code, year)
+
+
+@pytest.mark.parametrize("question, tbl, code, early, late", [
+    ("2020년부터 2023년까지 경기도 성남시 인구는 몇 명 늘었어?", "FAKE13_GG", "31020", "2020", "2023"),
+    ("2021년 대비 2022년 부산광역시 서구 사업체수는 얼마나 늘었어?", "FAKE13_BS", "26020", "2021", "2022"),
+])
+def test_change_of_a_district_after_its_province(res, question, tbl, code, early, late):
+    facts, answer = ask(res, question, tbl)
+    assert cells(answer) == sorted([ref(tbl, code, early), ref(tbl, code, late)])
+    amounts = [f for f in computed(answer) if "/" not in (f.derivation or "")]
+    assert amounts and amounts[0].value == pytest.approx(value(tbl, code, late) - value(tbl, code, early), abs=0.01)
+    assert refs_in(facts, amounts[0]) == sorted([ref(tbl, code, early), ref(tbl, code, late)])
+
+
+@pytest.mark.parametrize("question, tbl, a, b, year", [
+    ("2022년 경기도 고양시와 용인시 인구 차이는?", "FAKE13_GG", "31030", "31040", "2022"),
+    ("2023년 부산 중구와 해운대구의 사업체수 차이는 얼마야?", "FAKE13_BS", "26010", "26030", "2023"),
+])
+def test_difference_of_two_districts_after_their_province(res, question, tbl, a, b, year):
+    facts, answer = ask(res, question, tbl)
+    calc = computed(answer)
+    assert len(calc) == 1
+    assert refs_in(facts, calc[0]) == sorted([ref(tbl, a, year), ref(tbl, b, year)])
+    assert abs(calc[0].value) == pytest.approx(abs(value(tbl, a, year) - value(tbl, b, year)), abs=0.01)
+    assert cells(answer) == sorted([ref(tbl, a, year), ref(tbl, b, year)])
+
+
+@pytest.mark.parametrize("question, tbl, code, year", [
+    ("2023년 인구는 몇 명이야?", "FAKE13_GG", "31000", "2023"),
+    ("2020년 사업체수 알려줘", "FAKE13_BS", "26000", "2020"),
+])
+def test_no_region_named_is_the_province(res, question, tbl, code, year):
+    _, answer = ask(res, question, tbl)
+    assert cells(answer) == [ref(tbl, code, year)]
+
+
+# ---------------------------------------------------------------- neighbours
+
+
+def test_neighbour_provinces_after_a_total_are_candidates(res):
+    _, answer = ask(res, "2023년 인구가 가장 많은 시도는?", "FAKE13_NA")
+    assert cells(answer) == [ref("FAKE13_NA", "11", "2023")]
+
+
+def test_neighbour_province_and_district_side_by_side(res):
+    _, answer = ask(res, "2023년 경기도와 수원시 인구를 각각 알려줘", "FAKE13_GG")
+    assert cells(answer) == sorted([ref("FAKE13_GG", "31000", "2023"), ref("FAKE13_GG", "31010", "2023")])
+
+
+def test_neighbour_numbered_codes_are_not_linked(tmp_path):
+    """Codes padded with zeros that count (a regional category of numbered places) and no province name."""
+    from kosis_chat.prepare.index import index_of
+
+    regions = (("100", "제1구역"), ("110", "제2구역"), ("120", "제3구역"))
+    rows = _rows("Z1", "인구", "명", "지역별", regions, [10, 20])
+    table = load_resources(load_table(write_table(tmp_path / "data", "FAKE13_ZN", rows, catalog("가상 지역별 인구")))).table
+    axis = next(a for a in index_of(table).axes.values() if a.regional)
+    assert all(p is None for p in axis.parents.values())
diff --git a/tests/loop/test_loop13_scope_words.py b/tests/loop/test_loop13_scope_words.py
new file mode 100644
index 0000000..88c9bc3
--- /dev/null
+++ b/tests/loop/test_loop13_scope_words.py
@@ -0,0 +1,256 @@
+"""Loop 13 A-2 and A-3 (analyze/rules.py _within, _scope; judge/rules.py _named_apart; shared WHOLE_AFTER, RANK_TOP).
+
+A-2: a share whose whole is a region said with a word of the whole and the item before the word of looking inside
+("서울 전체 인구 중 종로구가 차지하는 비중"). The scope readings read past the word of the whole (shared WHOLE_AFTER) as
+they read past other names, so the region is the whole, not the category's total.
+
+A-3: a ranking inside a region whose members are said by their count and unit noun before the word of looking inside
+("서울의 3개 구 중"), or by the unit noun as the candidates' noun with no such word ("부산에서 가구가 가장 많은 구는").
+The unit noun is read from the table: the letters the members' names end with (_member_ends).
+
+Neighbours: an item named alone before the word of looking inside with a part of another category (the total of the
+category is the whole), a region fixed and another category's noun as the candidates, a region fixed and the periods
+ranked, a region with no members, and the first n places said by a count with no pool.
+
+The tables are made up (가상 데이터); every test checks the values and the cells they come from.
+"""
+
+from __future__ import annotations
+
+import re
+
+import pytest
+
+from conftest import write_table
+from kosis_chat.adapters.parquet import load_table
+from kosis_chat.calc import calculate
+from kosis_chat.schemas.resources import load_resources
+
+YEARS = ["2020", "2021", "2022", "2023"]
+REGIONS = (("00", "전국"), ("11", "서울특별시"), ("11010", "종로구"), ("11020", "용산구"), ("11030", "마포구"),
+           ("26", "부산광역시"), ("26010", "해운대구"), ("26020", "수영구"), ("26030", "동래구"), ("36", "세종특별자치시"))
+ITEMS = (("T1", "인구", "명", 1), ("T2", "가구", "가구", 0.4))
+SEXES = (("0", "계"), ("1", "남자"), ("2", "여자"))
+
+
+def _district(y):
+    return {"11010": 150 + y, "11020": 230 - 2 * y, "11030": 370 + 3 * y, "26010": 410 - y, "26020": 170 + 2 * y,
+            "26030": 300 + 5 * y}
+
+
+def region_rows():
+    out = []
+    for y, year in enumerate(YEARS):
+        for item, name, unit, scale in ITEMS:
+            d = {k: round(v * scale) for k, v in _district(y).items()}
+            d["11"] = d["11010"] + d["11020"] + d["11030"]
+            d["26"] = d["26010"] + d["26020"] + d["26030"]
+            d["36"] = round((90 + 4 * y) * scale)
+            d["00"] = d["11"] + d["26"] + d["36"]
+            out += [{"period": year, "item_id": item, "item_name": name, "unit": unit, "dim1_name": "행정구역별",
+                     "dim1_code": c, "dim1_label": l, "value_raw": str(d[c]), "value": d[c]} for c, l in REGIONS]
+    return out
+
+
+def sex_rows():
+    """인구 by 시도 (the regions above) and 성별: a second category of parts."""
+    out = []
+    for y, year in enumerate(YEARS):
+        d = _district(y)
+        for c, l in REGIONS:
+            if c in d:
+                total = d[c]
+            elif c == "11":
+                total = d["11010"] + d["11020"] + d["11030"]
+            elif c == "26":
+                total = d["26010"] + d["26020"] + d["26030"]
+            elif c == "36":
+                total = 90 + 4 * y
+            else:
+                total = sum(d.values()) + 90 + 4 * y
+            male = total * 49 // 100
+            for (sc, sl), v in zip(SEXES, (total, male, total - male), strict=True):
+                out.append({"period": year, "item_id": "T1", "item_name": "인구", "unit": "명",
+                            "dim1_name": "행정구역별", "dim1_code": c, "dim1_label": l, "dim2_name": "성별",
+                            "dim2_code": sc, "dim2_label": sl, "value_raw": str(v), "value": v})
+    return out
+
+
+def catalog(title):
+    return {"survey_name": "가상 조사", "organization": "가상 기관", "table_name": title, "period": "년",
+            "url": "https://example.invalid/t"}
+
+
+SPECS = {
+    "FAKE13_RG": (region_rows, catalog("가상 행정구역별 인구와 가구")),
+    "FAKE13_SX": (sex_rows, catalog("가상 행정구역별 성별 인구")),
+}
+ROWS = {t: make() for t, (make, _) in SPECS.items()}
+
+
+@pytest.fixture(scope="module")
+def res(tmp_path_factory):
+    folder = tmp_path_factory.mktemp("loop13s") / "data"
+    return {t: load_resources(load_table(write_table(folder, t, ROWS[t], cat))) for t, (_, cat) in SPECS.items()}
+
+
+def ask(res, question, tbl):
+    got = calculate(question, [res[tbl]])
+    assert got.status == "ok", (got.status, got.reason, got.detail)
+    facts = {f.id: f for f in got.facts}
+    return facts, [facts[i] for i in got.answer]
+
+
+def refs_in(facts, fact):
+    out = []
+    for i in re.findall(r"f\d+", fact.derivation or ""):
+        f = facts[i]
+        out += refs_in(facts, f) if f.derivation else [f.source_ref]
+    return sorted(out)
+
+
+def value(tbl, item, code, year, sex=None):
+    return next(r["value"] for r in ROWS[tbl] if r["dim1_code"] == code and r["period"] == year
+                and r["item_id"] == item and (sex is None or r.get("dim2_code") == sex))
+
+
+def ref(tbl, item, code, year, sex=None):
+    return f"{tbl}|{item}|{code}|{year}" if sex is None else f"{tbl}|{item}|{code}|{sex}|{year}"
+
+
+def cells(answer):
+    return sorted(f.source_ref for f in answer if f.source_ref)
+
+
+def computed(answer):
+    return [f for f in answer if not f.source_ref]
+
+
+# ---------------------------------------------------------------- A-2: the region's whole as a share's whole
+
+
+@pytest.mark.parametrize("question, item, part, whole, year", [
+    ("2023년 서울 전체 인구 중 종로구가 차지하는 비중은?", "T1", "11010", "11", "2023"),
+    ("2021년 부산광역시 전체 가구 가운데 수영구 가구의 비중은 얼마야?", "T2", "26020", "26", "2021"),
+])
+def test_share_of_a_district_in_its_whole_province(res, question, item, part, whole, year):
+    facts, answer = ask(res, question, "FAKE13_RG")
+    calc = computed(answer)
+    assert len(calc) == 1
+    expect = value("FAKE13_RG", item, part, year) / value("FAKE13_RG", item, whole, year) * 100
+    assert calc[0].value == pytest.approx(round(expect, 2), abs=0.01)
+    assert refs_in(facts, calc[0]) == sorted([ref("FAKE13_RG", item, part, year), ref("FAKE13_RG", item, whole, year)])
+
+
+def test_share_change_of_a_district_in_its_whole_province(res):
+    facts, answer = ask(res, "2020년과 2023년 사이 서울 전체 인구 중 마포구가 차지하는 비중은 얼마나 변했어?", "FAKE13_RG")
+    calc = computed(answer)
+    shares = [round(value("FAKE13_RG", "T1", "11030", y) / value("FAKE13_RG", "T1", "11", y) * 100, 2)
+              for y in ("2020", "2023")]
+    assert sorted(round(f.value, 2) for f in calc if "*" in (f.derivation or "")) == sorted(shares)
+    used = sorted({r for f in calc for r in refs_in(facts, f)})
+    assert used == sorted(ref("FAKE13_RG", "T1", c, y) for c in ("11", "11030") for y in ("2020", "2023"))
+
+
+def test_neighbour_item_alone_before_the_scope_word(res):
+    """"인구 중 여자" with no region whole: the share of the sex in the region's 인구 (the sex category's total)."""
+    facts, answer = ask(res, "2022년 서울 인구 중 여자가 차지하는 비중은?", "FAKE13_SX")
+    calc = computed(answer)
+    expect = value("FAKE13_SX", "T1", "11", "2022", "2") / value("FAKE13_SX", "T1", "11", "2022", "0") * 100
+    assert calc[0].value == pytest.approx(round(expect, 2), abs=0.01)
+    assert refs_in(facts, calc[0]) == sorted([ref("FAKE13_SX", "T1", "11", "2022", "0"),
+                                              ref("FAKE13_SX", "T1", "11", "2022", "2")])
+
+
+def test_neighbour_district_share_with_no_province_named(res):
+    facts, answer = ask(res, "2023년 전국 인구 중 해운대구가 차지하는 비중은?", "FAKE13_RG")
+    calc = computed(answer)
+    expect = value("FAKE13_RG", "T1", "26010", "2023") / value("FAKE13_RG", "T1", "00", "2023") * 100
+    assert calc[0].value == pytest.approx(round(expect, 2), abs=0.01)
+
+
+# ---------------------------------------------------------------- A-3: a ranking inside a region
+
+
+@pytest.mark.parametrize("question, item, code, year", [
+    ("2023년 서울의 3개 구 중 인구가 가장 많은 곳은?", "T1", "11030", "2023"),
+    ("2020년 부산의 세 개 구 가운데 가구가 가장 적은 곳은?", "T2", "26020", "2020"),
+    ("2022년 부산에서 가구가 가장 많은 구는?", "T2", "26010", "2022"),
+    ("2021년 서울에서 인구가 제일 적은 구는 어디야?", "T1", "11010", "2021"),
+])
+def test_ranking_among_the_districts_of_a_province(res, question, item, code, year):
+    _, answer = ask(res, question, "FAKE13_RG")
+    assert cells(answer) == [ref("FAKE13_RG", item, code, year)]
+    assert answer[0].value == value("FAKE13_RG", item, code, year)
+
+
+def test_neighbour_region_fixed_and_another_category_ranked(res):
+    _, answer = ask(res, "2023년 부산에서 인구가 가장 많은 성별은?", "FAKE13_SX")
+    assert cells(answer) == [ref("FAKE13_SX", "T1", "26", "2023", "2")]
+
+
+def test_neighbour_region_fixed_and_the_periods_ranked(res):
+    _, answer = ask(res, "서울 인구가 가장 많았던 해는?", "FAKE13_RG")
+    best = max(YEARS, key=lambda y: value("FAKE13_RG", "T1", "11", y))
+    assert cells(answer) == [ref("FAKE13_RG", "T1", "11", best)]
+
+
+def test_neighbour_first_places_by_a_count_with_no_pool(res):
+    _, answer = ask(res, "2023년 인구가 가장 많은 2개 시도는?", "FAKE13_RG")
+    assert cells(answer) == sorted([ref("FAKE13_RG", "T1", "11", "2023"), ref("FAKE13_RG", "T1", "26", "2023")])
+
+
+# ---------------------------------------------------------------- C-1: the two sexes as one word with a word of the whole
+
+
+def _best(year, pick):
+    provinces = ("11", "26", "36")
+    return pick(provinces, key=lambda c: value("FAKE13_SX", "T1", c, year, "0"))
+
+
+@pytest.mark.parametrize("question, year, pick", [
+    ("2023년 남녀 전체로 봤을 때 인구가 가장 많은 시도는?", "2023", max),
+    ("2021년 남녀를 합쳐서 인구가 가장 적은 시도는?", "2021", min),
+])
+def test_ranking_with_both_sexes_as_the_whole(res, question, year, pick):
+    _, answer = ask(res, question, "FAKE13_SX")
+    code = _best(year, pick)
+    assert cells(answer) == [ref("FAKE13_SX", "T1", code, year, "0")]
+
+
+@pytest.mark.parametrize("question, code, year", [
+    ("2022년 서울의 남녀 전체 인구는?", "11", "2022"),
+    ("2020년 부산의 성별 전체 인구는 몇 명이야?", "26", "2020"),
+])
+def test_value_with_both_sexes_as_the_whole_is_the_total_cell(res, question, code, year):
+    _, answer = ask(res, question, "FAKE13_SX")
+    assert [f.source_ref for f in answer] == [ref("FAKE13_SX", "T1", code, year, "0")]
+
+
+def test_neighbour_both_sexes_each(res):
+    _, answer = ask(res, "2022년 서울의 남녀 인구를 각각 알려줘", "FAKE13_SX")
+    assert cells(answer) == sorted(ref("FAKE13_SX", "T1", "11", "2022", s) for s in ("1", "2"))
+
+
+def test_neighbour_both_sexes_difference(res):
+    facts, answer = ask(res, "2023년 부산의 남녀 인구 차이는?", "FAKE13_SX")
+    calc = computed(answer)
+    assert len(calc) == 1
+    assert abs(calc[0].value) == pytest.approx(abs(value("FAKE13_SX", "T1", "26", "2023", "2")
+                                                   - value("FAKE13_SX", "T1", "26", "2023", "1")))
+    assert refs_in(facts, calc[0]) == sorted(ref("FAKE13_SX", "T1", "26", "2023", s) for s in ("1", "2"))
+
+
+@pytest.mark.parametrize("question, code, sex, year", [
+    ("2023년 서울 남녀 전체 인구 중 여자가 차지하는 비중은?", "11", "2", "2023"),
+    ("2021년 부산의 남녀 전체 인구 가운데 남자 비중은?", "26", "1", "2021"),
+])
+def test_neighbour_one_sex_named_apart_is_the_part_of_the_region_whole(res, question, code, sex, year):
+    """The two sexes with a word of the whole and one sex named apart: the sex is the part, the region's total the
+    whole (the pair word is read past as a name when the region is the group looked inside)."""
+    facts, answer = ask(res, question, "FAKE13_SX")
+    calc = computed(answer)
+    expect = value("FAKE13_SX", "T1", code, year, sex) / value("FAKE13_SX", "T1", code, year, "0") * 100
+    assert len(calc) == 1 and calc[0].value == pytest.approx(round(expect, 2), abs=0.01)
+    assert refs_in(facts, calc[0]) == sorted([ref("FAKE13_SX", "T1", code, year, sex),
+                                              ref("FAKE13_SX", "T1", code, year, "0")])
