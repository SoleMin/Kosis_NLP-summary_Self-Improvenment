+
+def refs_in(facts, fact):
+    out = []
+    for i in re.findall(r"f\d+", fact.derivation or ""):
+        f = facts[i]
+        out += refs_in(facts, f) if f.derivation else [f.source_ref]
+    return sorted(out)
+
+
+def value(tbl, item, code, year):
+    return next(r["value"] for r in ROWS[tbl] if r["dim1_code"] == code and r["period"] == year and r["item_id"] == item)
+
+
+@pytest.mark.parametrize("question, code, year", [
+    ("2023년 서울에서 청년취업자가 전체에서 차지하는 비중은?", "11", "2023"),
+    ("2021년 부산은 전체 가운데 청년취업자가 몇 퍼센트야?", "26", "2021"),
+])
+def test_share_over_the_unnamed_table_whole(res, question, code, year):
+    got = calculate(question, [res["FAKE13_YTH"], res["FAKE13_IND"]])
+    assert got.status == "ok", (got.status, got.reason, got.detail)
+    facts = {f.id: f for f in got.facts}
+    calc = [facts[i] for i in got.answer if not facts[i].source_ref]
+    expect = value("FAKE13_YTH", "Y1", code, year) / value("FAKE13_IND", "E0", code, year) * 100
+    assert len(calc) == 1 and calc[0].value == pytest.approx(round(expect, 2), abs=0.01)
+    assert refs_in(facts, calc[0]) == sorted([f"FAKE13_YTH|Y1|{code}|{year}", f"FAKE13_IND|E0|{code}|{year}"])
+
+
+def test_neighbour_table_of_different_measures_stays_open(res):
+    got = calculate("2023년 서울에서 청년취업자가 전체에서 차지하는 비중은?", [res["FAKE13_YTH"], res["FAKE13_RATE"]])
+    assert got.status != "ok"
+
+
+def test_neighbour_no_item_named_fills_nothing(res):
+    got = calculate("2023년 서울에서 전체 중 차지하는 비중은?", [res["FAKE13_IND"], res["FAKE13_RATE"]])
+    assert got.status != "ok"
diff --git a/tests/loop/test_loop13_number_ranges.py b/tests/loop/test_loop13_number_ranges.py
