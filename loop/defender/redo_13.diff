+    if m := re.match(r"^(\d+)[-~∼](\d+)$", core):  # an interval with no counting word ('0-4', '5~9')
+        return (int(m.group(1)), int(m.group(2)), "") if int(m.group(1)) <= int(m.group(2)) else None
