# loop/config.env 에 넣을 설정의 예시. scripts/loop.sh 가 loop/config.env 를 읽어 scripts/loop_main.py 에 넘김.
# 값은 PC에 맞게 고칠 것. 이 파일 자체는 읽히지 않음.

# ---- 에이전트 실행 파일 (PATH에 없으면 전체 경로)
CLAUDE_BIN="C:/Users/<사용자>/.local/bin/claude.exe"
CODEX_BIN="C:/Users/<사용자>/AppData/Local/OpenAI/Codex/bin/<해시>/codex.exe"

# ---- 역할별 명령. 지시문은 표준 입력으로 들어가고, 이 폴더(kosis_loop)에서 실행됨.
# LOOP_NUM(루프 번호)과 LOOP_ROLE(attacker | defender | critic)이 환경 변수로 넘어감.
# 모델 이름과 옵션은 설치된 CLI 버전에서 확인할 것 (claude --help, codex exec --help).
# 방어자는 --output-format stream-json --verbose 가 있어야 접근 흔적 검사를 할 수 있음.
ATTACKER_CMD='"$CODEX_BIN" exec --sandbox workspace-write -m <GPT-6.2 Astra 모델 이름> -c model_reasoning_effort="medium" -'
DEFENDER_CMD='"$CLAUDE_BIN" -p "표준 입력으로 받은 지시문을 수행한다." --model claude-opus-5-5 --effort medium --permission-mode acceptEdits --allowedTools "Read,Grep,Glob,Edit,Write,Bash" --max-turns 200 --output-format stream-json --verbose'
CRITIC_CMD='"$CLAUDE_BIN" -p "표준 입력으로 받은 지시문을 수행한다." --model claude-fable-5-2 --effort high --permission-mode acceptEdits --allowedTools "Read,Grep,Glob,Edit,Write,Bash" --max-turns 200 --output-format stream-json --verbose'
# 평가자의 가벼운 단계(힌트, 1차·2차 판정과 다시 요청, 기록 초안, 기록 다시 쓰기, 브리프 다시 쓰기)만 이 명령으로 돌림.
# 비우면 모두 CRITIC_CMD. 탐색 심사, 브리프, 코드 검토는 늘 CRITIC_CMD.
CRITIC_LIGHT_CMD='"$CLAUDE_BIN" -p "표준 입력으로 받은 지시문을 수행한다." --model claude-opus-5-5 --effort medium --permission-mode acceptEdits --allowedTools "Read,Grep,Glob,Edit,Write,Bash" --max-turns 200 --output-format stream-json --verbose'

# ---- 평가
KOSIS_WORKSPACE="C:/Users/<사용자>/.../KOSIS-ai-multi-agent"   # data/ 가 있는 폴더
EVAL_BACKEND=rules          # rules: 규칙만, 모델 호출 없음 (2026-11-21 결정: 루프의 측정은 이것으로) / hcx: 분류 매핑 모델까지 포함
EVAL_ARGS=""                # evals/run_calc.py 에 그대로 넘김. rules 에서는 비워 둠

# ---- 루프
MAX_ITER=10                 # 한 번 실행에서 도는 최대 루프 수
PATIENCE=3                  # 연속으로 유지하지 못한 루프 수가 이만큼이면 종료
ATTACK_COUNT=20             # 루프당 공격 문항 수
ATTACK_MIN=5                # 유효한 공격 문항이 이보다 적으면 종료
REGRESS_MAX=2               # 유지되는 수정이 떨어뜨려도 되는 문항 수(기준 데이터+지난 공격). 0이면 하나도 안 됨. 갚지 않은 회귀 빚 한 건마다 하나씩 줄어듦
DEBT_LIFE=3                 # 회귀 빚이 이 루프 수를 넘게 남으면 loop/attack/debt_expired.json으로 옮김 (0: 옮기지 않음)
HOLDOUT_EVERY=5             # 이 루프 수마다 루프 시작 전에 보관용 점수를 잼 (0: 재지 않음)
HOLDOUT_DROP=0.01           # 보관용 점수가 이보다 많이 떨어졌는데 기준 점수가 올랐으면 멈추고 사람에게 넘김
BAD_RATIO=0.5               # 1차 판정에서 부적절 비율이 이 이상이면 다시 작성
AGENT_TIMEOUT=5400          # 에이전트 한 번의 최대 실행 시간(초)
AGENT_RETRY_WAIT=1800       # 에이전트가 실패로 끝났을 때(사용량 한도 등) 같은 단계를 다시 실행하기까지 기다리는 시간(초)
AGENT_RETRY_MAX=12          # 다시 실행하는 최대 횟수. 다 쓰면 그 루프를 기록하지 않고 멈춤 (0: 기다리지 않고 바로 멈춤)
RECORD_COMMIT=1             # 1: 루프마다 이 저장소에 기록 파일을 커밋 (push는 하지 않음)

# ---- 그 밖 (비워 두면 기본값)
VERIFY_CMD=""               # 비우면 기본 검사: import 확인, tests/test_layout.py, 창구 테스트(큰 표 읽기), tests/loop
PHASE1_DIR="kosis-ai-nlp-summary-T1-30"
LOOP_BRANCH="loop-phase1-calc"
VAULT_DIR=""                # 방어자가 도는 동안 evals/ 등을 옮겨 둘 폴더. 비우면 홈 폴더의 .kosis_loop_vault
CONDA_ENV="kosis"           # 루프와 세 에이전트가 쓸 파이썬의 conda 환경 이름. scripts/loop.sh 가 그 폴더를 찾아 PATH 맨 앞에 둠
CONDA_ENV_DIR=""            # 환경을 찾지 못한다고 나올 때만: 그 환경의 폴더 (Anaconda Prompt 의 conda env list 에 나옴)
PYTHON=""                   # 위 둘 대신 파이썬 실행 파일을 직접 정할 때만 (전체 경로). 비워 둠
